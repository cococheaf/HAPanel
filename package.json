{
  "name": "hapanel",
  "version": "0.1.0-alpha.5",
  "private": true,
  "description": "An independent, touch-first Home Assistant dashboard and visual editor.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "format": "prettier --write src tests scripts .github *.json *.yaml *.html *.ts *.md docs",
    "dev": "concurrently -k -n api,web \"tsx watch src/server/index.ts\" \"vite --host 127.0.0.1\"",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "npm run check && vite build && tsup src/server/index.ts --format esm --platform node --target node22 --out-dir dist/server --sourcemap",
    "build:demo": "vite build --mode demo && node scripts/prepare-demo.mjs",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.8",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.12.7",
    "lucide-react": "^0.577.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-grid-layout": "^2.3.0",
    "ws": "^8.18.3",
    "yaml": "^2.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
