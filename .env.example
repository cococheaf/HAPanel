# Demo is the default. The server binds to loopback and never contacts HA.
HAPANEL_MODE=demo
HAPANEL_DATA_DIR=.data
# For a standalone HA connection (keep this file private):
# HAPANEL_MODE=standalone
# HA_URL=https://homeassistant.example
# HA_TOKEN=your-server-side-token
# Ingress mode is configured by the add-on's entrypoint.
